# Copy to .env and fill in. Never commit .env.

# development | test | production
APP_ENV=development

# Required in production: a random value of at least 32 characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value

# docker-compose.yml builds this for you in development.
DATABASE_URL=postgresql+asyncpg://cermat:cermat@db:5432/cermat
# docker-compose.prod.yml only:
POSTGRES_PASSWORD=replace-me

# AI provider. Without a key, extraction is unavailable and Ask cermat. falls back
# to keyword planning and record-built answers.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-luna
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2

# Only needed if a browser calls the API directly from another origin.
CORS_ORIGINS=

MAX_UPLOAD_MB=15
MAX_PDF_PAGES=30

# local | s3 (any S3-compatible service)
STORAGE_PROVIDER=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

RATE_LIMIT_AI_PER_MINUTE=20
LOG_LEVEL=INFO
